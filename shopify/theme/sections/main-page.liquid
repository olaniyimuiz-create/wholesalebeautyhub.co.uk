{%- render 'breadcrumbs' -%}

<div class="main-page" data-section-id="{{ section.id }}" data-section-type="main-page">
  <div class="container main-page__inner">
    <h1 class="main-page__title">{{ page.title }}</h1>
    <div class="main-page__content">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{ "name": "t:sections.main-page.name" }
{% endschema %}
