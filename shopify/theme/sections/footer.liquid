<footer class="footer" data-section-id="{{ section.id }}" data-section-type="footer">
  <div class="container footer__inner">

    {%- if section.settings.show_newsletter -%}
      <div class="footer__newsletter">
        <h2 class="footer__newsletter-heading">{{ 'sections.footer.newsletter_heading' | t }}</h2>
        <p class="footer__newsletter-subheading">{{ 'sections.footer.newsletter_subheading' | t }}</p>
        {%- form 'customer', id: 'footer-newsletter-form', class: 'footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
            {{ 'sections.footer.newsletter_email_placeholder' | t }}
          </label>
          <input
            type="email"
            id="NewsletterEmail-{{ section.id }}"
            name="contact[email]"
            placeholder="{{ 'sections.footer.newsletter_email_placeholder' | t }}"
            required
            autocomplete="email"
          >
          <button type="submit" class="btn btn--primary">{{ 'sections.footer.newsletter_submit' | t }}</button>
          {%- if form.posted_successfully? -%}
            <p class="alert alert--success" role="status">{{ 'sections.footer.newsletter_success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="alert alert--error" role="alert">{{ 'sections.footer.newsletter_error' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__column-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="footer__link-list" role="list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div class="footer__column footer__column--text" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__column-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <div class="footer__text">{{ block.settings.content }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_social -%}
      <div class="footer__social">
        {%- if settings.social_instagram_url != blank -%}
          <a href="{{ settings.social_instagram_url }}" aria-label="{{ 'general.social.follow_on' | t: platform: 'Instagram' }}">{%- render 'icon', name: 'instagram' -%}</a>
        {%- endif -%}
        {%- if settings.social_tiktok_url != blank -%}
          <a href="{{ settings.social_tiktok_url }}" aria-label="{{ 'general.social.follow_on' | t: platform: 'TikTok' }}">{%- render 'icon', name: 'tiktok' -%}</a>
        {%- endif -%}
        {%- if settings.social_facebook_url != blank -%}
          <a href="{{ settings.social_facebook_url }}" aria-label="{{ 'general.social.follow_on' | t: platform: 'Facebook' }}">{%- render 'icon', name: 'facebook' -%}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "t:sections.footer.settings.show_newsletter.label", "default": true },
    { "type": "checkbox", "id": "show_social", "label": "t:sections.footer.settings.show_social.label", "default": true }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [{ "type": "link_list" }]
    }
  ]
}
{% endschema %}
