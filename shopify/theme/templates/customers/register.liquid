<div class="container auth-page">
  <h1>Create account</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <div class="alert alert--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label for="FirstName">First name</label>
    <input type="text" id="FirstName" name="customer[first_name]" autocomplete="given-name">
    <label for="LastName">Last name</label>
    <input type="text" id="LastName" name="customer[last_name]" autocomplete="family-name">
    <label for="Email">Email</label>
    <input type="email" id="Email" name="customer[email]" autocomplete="email" required>
    <label for="CreatePassword">Password</label>
    <input type="password" id="CreatePassword" name="customer[password]" autocomplete="new-password" required>
    <button type="submit" class="btn btn--primary">Create account</button>
  {%- endform -%}
  <p>Already have an account? <a href="{{ routes.account_login_url }}">Log in</a></p>
</div>
