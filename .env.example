# Shopify Admin API credentials - TEMPLATE ONLY. Copy to .env and fill in
# real values; .env itself is git-ignored and must never be committed.
# See docs/PHASE9_ENVIRONMENT_READINESS.md for how each value is obtained
# and what scopes are required.

# Which environment this file's values point at - helps prevent accidentally
# running a script against production when a test store was intended.
SHOPIFY_ENVIRONMENT=development

# Store domain, e.g. your-store.myshopify.com (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=wholesale-beautyhub.myshopify.com

# Admin API access token from a custom app (Settings > Apps > Develop apps).
# Never the Storefront API token - that's a different credential with
# different permissions and won't work for product writes.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# API version to target, e.g. 2025-01. Pin explicitly rather than "latest" -
# see docs/PHASE9_ENVIRONMENT_READINESS.md for why.
SHOPIFY_API_VERSION=

# Optional: webhook secret, only needed if this project ever registers
# webhooks (not used by anything built so far).
SHOPIFY_WEBHOOK_SECRET=
