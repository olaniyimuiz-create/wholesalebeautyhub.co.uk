# Raw DB export and parsed intermediates - contain real customer PII
# (names, emails, phone numbers, addresses). Never commit these.
migration/sql/*.sql
migration/sql/*.sql.gz
migration/data/*.json

# Generated Shopify import CSVs - also contain customer PII
shopify-theme/assets/shopify_products_import.csv
shopify-theme/assets/shopify_customers_import.csv

# Phase 10 customer dry-run outputs - per-record reports contain real
# customer PII (name, email, phone, address). Aggregate-only outputs
# (statistics.json, the schema-mapping trace) have no per-customer data
# and are safe to track - listed explicitly so a future per-record
# report added here doesn't get committed by accident.
reports/phase10_customer_manifest.csv
reports/phase10_customer_quarantine.csv
reports/phase10_customer_reconciliation_template.csv
reports/phase10_test_import_set.csv
!reports/phase10_customer_statistics.json
!reports/phase10_customer_mapping.csv

# Python
__pycache__/
*.pyc

# Shopify Admin API credentials - never commit real values. .env.example
# (placeholders only) is tracked; .env and any environment-specific variant
# are not. See docs/PHASE9_ENVIRONMENT_READINESS.md.
.env
.env.*
!.env.example


# Phase 10 customer import runtime outputs. The ledger and checkpoint carry
# Shopify customer GIDs tied to real people, and the phone-collision detail
# groups customers by a shared contact number - per-record, so never tracked.
# Only the aggregate result/summary JSON is safe to commit.
reports/phase10_customer_import_log.jsonl
reports/phase10_customer_import_checkpoint.jsonl
reports/phase10_phone_collisions.csv
!reports/phase10_customer_import_result.json
!reports/phase10_phone_uniqueness.json

# Name-conflict review sheet: contains real customer names and emails.
reports/phase10_name_conflict_review.csv

# Phone collision review: contains real phone numbers, emails and names.
reports/phase10_phone_collision_review.csv
!reports/phase10_phone_collision_summary.json
!reports/phase10_name_conflict_summary.json

# Address exception detail: contains real street addresses and postcodes.
reports/phase10_address_exceptions.csv
!reports/phase10_address_readiness.json

# Credential liveness ledger: fingerprints and status only, no token values.
!reports/phase10_credential_liveness.jsonl

# Province validation audit flags: province value + customer id is an address
# component tied to an identifier. Aggregates live in the statistics JSON.
reports/phase10_province_validation_flags.jsonl

# Tier-3 probe/test-import ledger. PII-free today (costs and statuses only),
# but a real Tier-3 run would append Shopify customer GIDs. Same class as the
# main import ledger, so gitignored for the same reason.
reports/phase10_test_import_log.jsonl

# Test import reconciliation: real customer field values.
reports/phase10_test_import_reconciliation.csv
!reports/phase10_test_import_result.json

# Phone format pre-check and dropped-phone log (risk #45). The dropped-phone
# log is the one file in Phase 10 that deliberately carries a raw phone
# number: telling a merchant which number was lost requires the original, and
# a hash cannot be handed back to a human to check. The exceptions CSV carries
# the same. Neither is ever tracked; the aggregate summary has no PII.
reports/phase10_dropped_phones.jsonl
reports/phase10_phone_format_exceptions.csv
!reports/phase10_phone_validation_summary.json

# Bulk importer dry-run audit simulation. Ledger-shaped, Woo ids only (the
# ledger schema rejects PII outright), but it is per-record and the same class
# as the real import ledger, so it is gitignored for the same reason. The
# aggregate dry-run JSON is tracked.
reports/phase10_bulk_import_dry_run.jsonl
reports/phase10_bulk_import_dry_run_checkpoint.jsonl
!reports/phase10_bulk_import_dry_run.json

# Tier-3 live-test audit trail. Ledger-shaped (the schema rejects PII), but a
# live Tier-3 run appends Shopify customer GIDs, so it is gitignored for the
# same reason the main import ledger is. The per-test simulation JSONs carry
# field names and Woo ids only, and are tracked.
reports/phase10_tier3_log.jsonl
reports/phase10_tier3_checkpoint.jsonl
reports/phase10_tier3_log.jsonl.simulation
reports/phase10_tier3_checkpoint.jsonl.simulation
!reports/phase10_tier3_simulation_tier3_test_1.json
!reports/phase10_tier3_simulation_tier3_test_2.json

# Pre-cleanup copy of the dropped-phone log, kept so the removal of 31 synthetic
# development entries is reversible. Same contents, same rule: it carries raw
# phone numbers and is never tracked.
reports/phase10_dropped_phones.pre-cleanup-backup.jsonl

# Gate 7 bulk run outputs. The ledger and checkpoint carry Shopify customer
# GIDs tied to real people, one row per record, exactly like the Tier-3 and
# dry-run ledgers - never tracked. The aggregate result JSON has no per-customer
# data and is safe to commit.
reports/phase10_bulk_import_ledger.jsonl
reports/phase10_bulk_import_checkpoint.jsonl
!reports/phase10_bulk_import_executor_result.json

# Phase 9/10/11 intermediate caches. .legacy_map_cache.pkl is a pickled
# customer/product map that contains real customer PII; .live_ids.json is a
# regenerable id cache. Both are rebuildable from source - never commit them.
reports/.legacy_map_cache.pkl
reports/.live_ids.json
